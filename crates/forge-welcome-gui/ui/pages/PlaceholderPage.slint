export component PlaceholderPage inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <bool> show-subtitle: true;

    background: #121212;

    Text {
        text: root.title;
        x: 56px;
        y: 42px;
        color: #ffffff;
        font-size: 28px;
        font-weight: 800;
    }

    if root.show-subtitle: Text {
        text: root.subtitle;
        x: 56px;
        y: 116px;
        color: #b8b8b8;
        font-size: 20px;
    }

    Rectangle {
        x: 56px;
        y: root.show-subtitle ? 180px : 130px;
        width: parent.width - 112px;
        height: root.show-subtitle ? 280px : 330px;
        border-radius: 14px;
        background: #181818cc;
        border-width: 1px;
        border-color: #333333;

        Text {
            text: "Coming Soon";
            color: #ff7a18;
            font-size: 30px;
            font-weight: 800;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}
